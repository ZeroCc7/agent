# Required for AI 生图编辑 (/api/edit/ai endpoint)
DASHSCOPE_API_KEY=your_dashscope_key_here

# Optional — set to true if file:// URIs fail (e.g. permission issues)
# USE_BASE64=true

# Optional — for cloud deployments with a public domain
# PUBLIC_BASE_URL=https://your-domain.com

# Optional server settings
HOST=0.0.0.0
PORT=8000
